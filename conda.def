Bootstrap: docker
From: condaforge/miniforge3:latest

%files
    ./env.yml /env.yml
    ./requirements.txt /requirements.txt

%post
    sed -i '/^visdom/d' /requirements.txt
    mamba env create --yes -f /env.yml
    /opt/conda/envs/venv/bin/pip install --no-build-isolation --no-deps visdom==0.2.4
    mamba clean --all -f -y

%environment
    export PATH="/opt/conda/envs/venv/bin:$PATH"

%runscript
    exec python "$@"